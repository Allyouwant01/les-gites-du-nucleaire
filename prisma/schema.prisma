generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  TENANT
  OWNER
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CARD
  CASH
  SPLIT
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  REFUNDED
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
}

enum SubscriptionPlan {
  MONTHLY_5EUR
}

enum NotificationType {
  NEW_BOOKING
  BOOKING_CONFIRMED
  BOOKING_CANCELLED
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  NEW_MESSAGE
  SPLIT_INVITE
  LISTING_VERIFIED
  LISTING_REJECTED
  REVIEW_RECEIVED
}

// ============================================================
// MODÈLE USER (Utilisateur)
// ============================================================

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  passwordHash            String?
  firstName               String
  lastName                String
  phone                   String?
  avatarUrl               String?
  role                    UserRole  @default(TENANT)
  isVerified              Boolean   @default(false)
  verificationDocumentUrl String?
  missionDocumentUrl      String?
  fcmToken                String?
  stripeCustomerId        String?
  emailVerified           Boolean   @default(false)
  phoneVerified           Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  listings             Listing[]
  bookings             Booking[]
  reviewsAuthored      Review[]           @relation("ReviewAuthor")
  sentMessages         Message[]          @relation("MessageSender")
  receivedMessages     Message[]          @relation("MessageReceiver")
  payments             Payment[]
  splitPayments        SplitPayment[]
  notifications        Notification[]
  subscription         OwnerSubscription?
  conversationUsers    ConversationUser[]

  @@map("users")
}

// ============================================================
// MODÈLE NUCLEAR PLANT (Centrale Nucléaire)
// ============================================================

model NuclearPlant {
  id           String  @id @default(cuid())
  name         String  @unique
  city         String
  department   String
  region       String
  latitude     Float
  longitude    Float
  imageUrl     String?
  description  String?
  reactorCount Int

  listings Listing[]

  @@map("nuclear_plants")
}

// ============================================================
// MODÈLE LISTING (Logement)
// ============================================================

model Listing {
  id              String   @id @default(cuid())
  title           String
  description     String
  address         String
  city            String
  postalCode      String
  latitude        Float
  longitude       Float
  pricePerWeek    Decimal  @db.Decimal(10, 2)
  maxGuests       Int
  bedrooms        Int
  bathrooms       Int
  amenities       String[]
  photos          String[]
  houseRules      String?
  isActive        Boolean  @default(true)
  isVerified      Boolean  @default(false)
  adminComment    String?
  distanceToPlant Float?

  ownerId        String
  owner          User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  nuclearPlantId String
  nuclearPlant   NuclearPlant @relation(fields: [nuclearPlantId], references: [id])

  bookings       Booking[]
  reviews        Review[]
  availabilities Availability[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nuclearPlantId])
  @@index([ownerId])
  @@index([city])
  @@index([pricePerWeek])
  @@map("listings")
}

// ============================================================
// MODÈLE AVAILABILITY (Disponibilités)
// ============================================================

model Availability {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  startDate   DateTime
  endDate     DateTime
  isAvailable Boolean  @default(true)

  @@index([listingId])
  @@index([startDate, endDate])
  @@map("availabilities")
}

// ============================================================
// MODÈLE BOOKING (Réservation)
// ============================================================

model Booking {
  id             String        @id @default(cuid())
  listingId      String
  listing        Listing       @relation(fields: [listingId], references: [id])
  tenantId       String
  tenant         User          @relation(fields: [tenantId], references: [id])
  checkInDate    DateTime
  checkOutDate   DateTime
  numberOfGuests Int
  totalPrice     Decimal       @db.Decimal(10, 2)
  weeklyPrice    Decimal       @db.Decimal(10, 2)
  numberOfWeeks  Int
  status         BookingStatus @default(PENDING)
  paymentMethod  PaymentMethod @default(CARD)

  // Dépôt de garantie (pour paiements espèces)
  depositAmount         Decimal?  @db.Decimal(10, 2)
  depositStripeId       String?
  depositRefunded       Boolean   @default(false)

  payments      Payment[]
  splitPayments SplitPayment[]
  review        Review?
  conversation  Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([tenantId])
  @@index([status])
  @@map("bookings")
}

// ============================================================
// MODÈLE PAYMENT (Paiement)
// ============================================================

model Payment {
  id                    String        @id @default(cuid())
  bookingId             String
  booking               Booking       @relation(fields: [bookingId], references: [id])
  userId                String
  user                  User          @relation(fields: [userId], references: [id])
  amount                Decimal       @db.Decimal(10, 2)
  platformFee           Decimal       @db.Decimal(10, 2) @default(0)
  ownerCommission       Decimal       @db.Decimal(10, 2) @default(0)
  method                PaymentMethod @default(CARD)
  status                PaymentStatus @default(PENDING)
  weekNumber            Int
  dueDate               DateTime
  paidAt                DateTime?
  stripePaymentIntentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@map("payments")
}

// ============================================================
// MODÈLE SPLIT PAYMENT (Paiement Partagé)
// ============================================================

model SplitPayment {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id])
  payerId     String?
  payer       User?   @relation(fields: [payerId], references: [id])
  payerEmail  String?
  payerName   String?
  amount      Decimal @db.Decimal(10, 2)
  isPaid      Boolean @default(false)
  inviteToken String  @unique @default(cuid())
  weekNumber  Int
  stripePaymentIntentId String?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([inviteToken])
  @@map("split_payments")
}

// ============================================================
// MODÈLE OWNER SUBSCRIPTION (Abonnement Propriétaire)
// ============================================================

model OwnerSubscription {
  id                   String             @id @default(cuid())
  ownerId              String             @unique
  owner                User               @relation(fields: [ownerId], references: [id])
  plan                 SubscriptionPlan   @default(MONTHLY_5EUR)
  status               SubscriptionStatus @default(ACTIVE)
  stripeSubscriptionId String?
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("owner_subscriptions")
}

// ============================================================
// MODÈLE REVIEW (Avis)
// ============================================================

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  authorId  String
  author    User    @relation("ReviewAuthor", fields: [authorId], references: [id])
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id])
  rating    Int
  comment   String
  response  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([authorId])
  @@map("reviews")
}

// ============================================================
// MODÈLE CONVERSATION
// ============================================================

model Conversation {
  id        String  @id @default(cuid())
  bookingId String? @unique
  booking   Booking? @relation(fields: [bookingId], references: [id])

  participants ConversationUser[]
  messages     Message[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversations")
}

model ConversationUser {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@map("conversation_users")
}

// ============================================================
// MODÈLE MESSAGE
// ============================================================

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  receiverId     String
  receiver       User         @relation("MessageReceiver", fields: [receiverId], references: [id])
  content        String
  readAt         DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([receiverId])
  @@map("messages")
}

// ============================================================
// MODÈLE NOTIFICATION
// ============================================================

model Notification {
  id     String           @id @default(cuid())
  userId String
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   NotificationType
  title  String
  body   String
  isRead Boolean          @default(false)
  data   Json?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}
